index 0000000..4120f3f
--- /dev/null
+++ b/src/decision_evidence_benchmark/adapters/quipu.py
@@ -0,0 +1,210 @@
+"""Quipu native evidence adapter.
+
+Quipu (github.com/scbrown/quipu) is a governed bitemporal knowledge-graph
+store whose write gate emits three evidence planes per decision: a
+writer-side ``guard_trace`` (executor, principal chain, tool, target,
+graph, instant), a signed ``verdict_ledger`` fact persisted in the store
+(policy, target, outcome, attribution, evidence hash, ed25519 signature),
+and a bitemporal ``policy_snapshot`` (the policy's claim as of the
+decision instant versus now, plus the writer's authority grants). This
+adapter translates one exported record into the benchmark case manifest,
+deriving property categories from record content only.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from typing import Any
+
+from decision_evidence_benchmark.schema import CaseManifest, PropertyLabel
+
+_PLANE_KEYS = ("guard_trace", "verdict_ledger", "policy_snapshot")
+
+
+def _planes(record: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
+    guard, verdict, policy = (dict(record.get(key) or {}) for key in _PLANE_KEYS)
+    return guard, verdict, policy
+
+
+def _actor_conflict(guard: dict[str, Any], verdict: dict[str, Any]) -> bool:
+    executor = guard.get("executor")
+    if not executor:
+        return False
+    chain = guard.get("principal_chain") or verdict.get("principal_chain")
+    if isinstance(chain, list) and chain and executor not in chain:
+        return True
+    attributed = verdict.get("attributed_writer")
+    return bool(attributed) and executor != attributed
+
+
+def _actor_identity(guard: dict[str, Any], verdict: dict[str, Any]) -> str:
+    if _actor_conflict(guard, verdict):
+        return "conflicting"
+    if guard.get("executor") or verdict.get("attributed_writer"):
+        return "complete"
+    return "opaque"
+
+
+def _principal_authority(
+    guard: dict[str, Any], verdict: dict[str, Any], policy: dict[str, Any]
+) -> str:
+    if _actor_conflict(guard, verdict):
+        return "conflicting"
+    chain = guard.get("principal_chain") or verdict.get("principal_chain")
+    grants = policy.get("authority_grants")
+    if chain and grants:
+        graph = guard.get("graph")
+        if not graph or "*" in grants or graph in grants:
+            return "complete"
+        return "partial"
+    if chain:
+        return "partial"
+    return "opaque"
+
+
+def _tiered(values: list[bool]) -> str:
+    if all(values):
+        return "complete"
+    return "partial" if any(values) else "opaque"
+
+
+def _policy_basis(
+    guard: dict[str, Any], verdict: dict[str, Any], policy: dict[str, Any]
+) -> str:
+    constraint_ids = [
+        constraint.get("id")
+        for constraint in guard.get("constraints", [])
+        if constraint.get("id") and constraint.get("id") != "redacted"
+    ]
+    named = bool(policy.get("iri") or verdict.get("predicate_id") or constraint_ids)
+    claim = bool(policy.get("claim_as_of") or policy.get("claim_current"))
+    if named and claim:
+        return "complete"
+    return "partial" if named else "opaque"
+
+
+def _decision_basis(guard: dict[str, Any], verdict: dict[str, Any]) -> str:
+    constraints = guard.get("constraints") or []
+    if any("outcome" in c and "response" in c for c in constraints):
+        return "complete"
+    if verdict.get("outcome") and guard.get("result"):
+        return "partial"
+    return "opaque"
+
+
+def _lifecycle_context(guard: dict[str, Any], policy: dict[str, Any]) -> str:
+    if guard.get("at") and policy.get("as_of"):
+        return "complete"
+    return "partial" if guard.get("at") else "opaque"
+
+
+def _verification_strength(
+    guard: dict[str, Any], verdict: dict[str, Any], policy: dict[str, Any]
+) -> str:
+    signed = [bool(verdict.get(k)) for k in ("signature", "verifier", "evidence_hash")]
+    grounded = bool(guard.get("principal_chain") or policy.get("authority_grants"))
+    if all(signed) and grounded:
+        return "complete"
+    return "partial" if any(signed) else "opaque"
+
+
+def _source_validator(
+    guard: dict[str, Any], verdict: dict[str, Any], policy: dict[str, Any]
+) -> bool:
+    """Quipu's regime-internal validity check: plane field completeness,
+    evidence-hash recomputation over what the verdict signs, executor and
+    chain consistency, and the target graph inside the writer's grants."""
+
+    guard_ok = all(
+        guard.get(k)
+        for k in ("executor", "principal_chain", "tool", "target", "graph", "at", "constraints")
+    )
+    verdict_ok = all(
+        verdict.get(k)
+        for k in (
+            "predicate_id",
+            "target_ref",
+            "outcome",
+            "attributed_writer",
+            "principal_chain",
+            "evidence_hash",
+            "verifier",
+            "signature",
+        )
+    )
+    policy_ok = all(
+        policy.get(k) for k in ("iri", "as_of", "claim_as_of", "targets", "authority_grants")
+    )
+    if not (guard_ok and verdict_ok and policy_ok):
+        return False
+    canonical = "|".join(
+        [
+            str(verdict["predicate_id"]),
+            str(verdict["target_ref"]),
+            str(verdict["outcome"]),
+            str(verdict["attributed_writer"]),
+            ",".join(str(link) for link in verdict["principal_chain"]),
+        ]
+    )
+    digest = "sha256:" + hashlib.sha256(canonical.encode()).hexdigest()
+    if verdict.get("evidence_hash") != digest:
+        return False
+    if guard["executor"] != verdict["attributed_writer"]:
+        return False
+    if guard["executor"] not in guard["principal_chain"]:
+        return False
+    grants = policy["authority_grants"]
+    return bool("*" in grants or guard["graph"] in grants)
+
+
+def from_native_record(record: dict[str, Any]) -> CaseManifest:
+    """Convert one exported quipu decision record into the case manifest."""
+
+    guard, verdict, policy = _planes(record)
+    source = "quipu_adapter"
+    return CaseManifest(
+        case_id=str(record["record_id"]),
+        regime="quipu",
+        question_family=str(record.get("question_family", "policy_basis")),
+        degradation_condition=str(record.get("degradation_condition", "none")),
+        evidence={key: record.get(key) for key in _PLANE_KEYS if record.get(key)},
+        container_flags={
+            "trace_present": bool(guard),
+            "ledger_present": bool(verdict.get("present")),
+            "schema_valid": True,
+            "checklist_complete": bool(guard) and bool(verdict) and bool(policy),
+            "source_validator_passed": _source_validator(guard, verdict, policy),
+            "llm_judge_verdict": str(record.get("llm_judge_verdict", "sufficient")),
+        },
+        property_labels=(
+            PropertyLabel("actor_identity", _actor_identity(guard, verdict), source=source),
+            PropertyLabel(
+                "principal_authority",
+                _principal_authority(guard, verdict, policy),
+                source=source,
+            ),
+            PropertyLabel(
+                "action_boundary",
+                _tiered([bool(guard.get(k)) for k in ("tool", "target", "graph")]),
+                source=source,
+            ),
+            PropertyLabel("policy_basis", _policy_basis(guard, verdict, policy), source=source),
+            PropertyLabel("decision_basis", _decision_basis(guard, verdict), source=source),
+            PropertyLabel(
+                "data_resource_touch",
+                _tiered([bool(guard.get(k)) for k in ("target", "graph")]),
+                source=source,
+            ),
+            PropertyLabel("lifecycle_context", _lifecycle_context(guard, policy), source=source),
+            PropertyLabel(
+                "verification_strength",
+                _verification_strength(guard, verdict, policy),
+                source=source,
+            ),
+        ),
+        metadata={
+            "adapter": "quipu",
+            "native_record_id": str(record["record_id"]),
+            "fixture_status": str(record.get("fixture_status", "adapter_generated")),
+        },
+    )
