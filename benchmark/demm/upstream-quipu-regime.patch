diff --git a/tests/test_adapter_quipu.py b/tests/test_adapter_quipu.py
new file mode 100644
index 0000000..966496e
--- /dev/null
+++ b/tests/test_adapter_quipu.py
@@ -0,0 +1,52 @@
+import json
+from pathlib import Path
+
+from decision_evidence_benchmark.adapters.quipu import from_native_record
+
+
+def test_quipu_adapter_marks_missing_policy_basis() -> None:
+    record = json.loads(Path("data/cases/quipu/missing_policy_001.native.json").read_text())
+    case = from_native_record(record)
+    labels = {label.property: label.category for label in case.property_labels}
+
+    assert case.regime == "quipu"
+    assert case.container_flags["trace_present"] is True
+    assert case.container_flags["ledger_present"] is True
+    assert case.container_flags["source_validator_passed"] is False
+    assert labels["actor_identity"] == "complete"
+    assert labels["principal_authority"] == "complete"
+    assert labels["policy_basis"] == "opaque"
+    assert labels["decision_basis"] == "complete"
+    assert labels["verification_strength"] == "complete"
+
+
+def test_quipu_adapter_marks_conflicting_identity_across_planes() -> None:
+    record = json.loads(Path("data/cases/quipu/missing_policy_001.native.json").read_text())
+    record["guard_trace"]["executor"] = "quilla"
+
+    case = from_native_record(record)
+    labels = {label.property: label.category for label in case.property_labels}
+
+    assert labels["actor_identity"] == "conflicting"
+    assert labels["principal_authority"] == "conflicting"
+
+
+def test_quipu_adapter_validator_rejects_swapped_attribution() -> None:
+    record = json.loads(Path("data/cases/quipu/missing_policy_001.native.json").read_text())
+    record["verdict_ledger"]["predicate_id"] = "urn:census:policy:tally-label"
+    record["policy_snapshot"].update(
+        {
+            "iri": "urn:census:policy:tally-label",
+            "claim_as_of": "ASK { ... }",
+            "targets": "urn:census:Tally",
+        }
+    )
+
+    intact = from_native_record(record)
+    assert intact.container_flags["source_validator_passed"] is True
+
+    record["verdict_ledger"]["attributed_writer"] = "quilla"
+    swapped = from_native_record(record)
+    # The evidence hash seals the attribution, so a swapped writer fails
+    # recomputation rather than needing a convention to notice.
+    assert swapped.container_flags["source_validator_passed"] is False
