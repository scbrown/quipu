test:
    uv run --no-project python -m unittest discover -s . -p 'test_*.py'

prepare db cohort output:
    uv run --no-project python prepare.py --db {{quote(db)}} --cohort {{quote(cohort)}} --output {{quote(output)}}

candidates db prepared model tokenizer output:
    uv run --script candidates.py --db {{quote(db)}} --prepared {{quote(prepared)}} --model {{quote(model)}} --tokenizer {{quote(tokenizer)}} --output {{quote(output)}}

replay items responses:
    uv run --no-project python replay.py --items {{quote(items)}} --responses {{quote(responses)}}
