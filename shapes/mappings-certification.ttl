# External-truth mappings and certified share-bundle vocabulary.
#
# This is the SHAPES-side contract for aegis-jsyl2, aegis-2rw3w and the
# certification addendum on aegis-33cgl.  Camayoc knowledge packs and Quipu
# share bundles use one envelope: a CertifiedShareBundle.  A mapping is carried
# directly by the entity whose external truth it locates; it is not a second
# shadow entity that can drift independently.
#
# Load via POST /shapes as `mappings-certification` only after the matching
# /propose review has been accepted.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix aegis: <http://aegis.gastown.local/ontology/> .

# Mapping predicates deliberately have no rdfs:domain.  They attach to several
# already-governed kinds (Artifact, Metric, APIEndpoint, ConfigFile, Document,
# DataCorpus and ExternalService); a domain would retype every carrier through
# RDFS inference.  The source spelling is snake_case because this is the exact
# serialized contract consumers were told not to invent independently.

aegis:source_uri a owl:DatatypeProperty ;
    rdfs:label "external truth source URI" ;
    rdfs:range xsd:string ;
    rdfs:comment "Where the entity's external truth lives, including s3, https, file-at-revision, PromQL and MCP identifiers." .

aegis:access_via a owl:DatatypeProperty ;
    rdfs:label "external truth access method" ;
    rdfs:range xsd:string ;
    rdfs:comment "Executable read method for source_uri: mcp, rest, sparql-federated, file, or promql." .

# aegis:freshness already exists on Verdict.  It is intentionally shared here
# instead of minting a nearly-identical predicate.  Class-targeted Verdict
# shapes retain their fresh|stale constraint; this targetSubjectsOf shape gives
# mapping carriers their distinct live|snapshot(ts)|frozen(window) contract.

aegis:verified_by a owl:DatatypeProperty ;
    rdfs:label "external truth verification method" ;
    rdfs:range xsd:string ;
    rdfs:comment "How bytes read through the mapping are checked: a content hash, cosign signature, or Quipu certification seal identifier." .

aegis:ExternalTruthMappingShape a sh:NodeShape ;
    sh:targetSubjectsOf aegis:source_uri ;
    sh:property [ sh:path aegis:source_uri ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path aegis:access_via ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "mcp" "rest" "sparql-federated" "file" "promql" )
    ] ;
    sh:property [
        sh:path aegis:freshness ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^(live|snapshot\\([^()]+\\)|frozen\\([^()]+\\))$"
    ] ;
    sh:property [ sh:path aegis:verified_by ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

# One converged distribution object.  A Camayoc knowledge pack is a
# CertifiedShareBundle; `.qpack` is its archive encoding, not a second semantic
# format.  The canonical graph hash is over the RDFC-normalized triple set.

aegis:CertifiedShareBundleShape a sh:NodeShape ;
    sh:targetClass aegis:CertifiedShareBundle ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:canonicalGraphHash ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:shapesBundleVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:provenanceManifest ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:publisherAttestation ; sh:class aegis:PublisherAttestation ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:certificationSeal ; sh:class aegis:KnowledgeCertificationSeal ; sh:minCount 1 ; sh:maxCount 1 ] .

# Two signatures are two claims, so they are two nodes rather than two
# ambiguous signature strings on the bundle.  Both keys resolve to the existing
# human-gated VerifierRegistration vocabulary used by shuttle.

aegis:PublisherAttestationShape a sh:NodeShape ;
    sh:targetClass aegis:PublisherAttestation ;
    sh:property [ sh:path aegis:attestsBundle ; sh:class aegis:CertifiedShareBundle ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:signingKey ; sh:class aegis:VerifierRegistration ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:attestationSignature ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

aegis:KnowledgeCertificationSealShape a sh:NodeShape ;
    sh:targetClass aegis:KnowledgeCertificationSeal ;
    sh:property [ sh:path aegis:certifiesBundle ; sh:class aegis:CertifiedShareBundle ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:canonicalGraphHash ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:shapesBundleVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:shaclReportHash ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:scrubCheckPass ; sh:datatype xsd:boolean ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:provenanceManifest ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:signingKey ; sh:class aegis:VerifierRegistration ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:attestationSignature ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:frozenWindow ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] .
