# Canonical tree-sitter-tier policy catalog — the source of truth Hank projects.
#
# These are the "structural / lexical" policies a linter finds hard or slow to
# express, composed from the governance atoms in shapes/governance.ttl: a
# Selector (a tree-sitter .scm capture query — which nodes) and a Predicate (a
# regex over their text + a direction — what they must / must not be), bound into
# an aegis:Policy at the boundary:"action" (pre-edit) seam.
#
# Evidence locality (hank docs/book/src/design/policy-edit-hooks.md): these carry
# tier "tree-sitter", so Hank — which holds that evidence hot — evaluates them at
# `hank hook pre-edit`. The definitions live HERE regardless; Hank holds only a
# projected read cache. The field names line up with Hank's rules::Rule:
#   aegis:Selector.evidenceSource   <->  Rule.query   (.scm)
#   aegis:Predicate.evidenceSource  <->  Rule.pattern (regex)
#   aegis:Predicate.matchType       <->  Rule.match_type
#   aegis:Predicate.gate            <->  Rule.gate
#
# Validate against the shapes before loading:
#   cargo test governance  (see src/governance_tests.rs)
# Load via POST /shapes / quipu knot.
#
# NB: a backslash in a Turtle string is an escape, so a regex `\b` is written
# `\\b` here.

@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix aegis: <http://aegis.gastown.local/ontology/> .

# ═══════════════════════════════════════════════════════════════════
# todo-needs-ticket — a TODO comment must cite a ticket (must-match, gated).
# effect "warn": advisory. The awkward-for-a-linter rule.
# ═══════════════════════════════════════════════════════════════════

aegis:sel_rust_line_comments a aegis:Selector ;
    aegis:name "rust-line-comments" ;
    aegis:evidenceSource "(line_comment) @c" ;
    aegis:language "rust" ;
    aegis:tier "tree-sitter" .

aegis:pred_todo_has_ticket a aegis:Predicate ;
    aegis:name "todo-has-ticket" ;
    aegis:evidenceSource "\\b[A-Z]+-[0-9]+\\b" ;
    aegis:matchType "must-match" ;
    aegis:gate "\\bTODO\\b" ;
    aegis:tier "tree-sitter" .

aegis:op_todo_has_ticket a aegis:OperatingPoint ;
    aegis:kind "exact_predicate" ;
    # A regex over a parsed comment: no classifier, so no score to threshold.
    # The residual error is a tree-sitter misparse, which the `tier` already
    # declares — it is not an FP rate this predicate can trade against.
    aegis:falsePositiveTolerance 0.0 ;
    aegis:falseNegativeTolerance 0.0 .

aegis:policy_todo_needs_ticket a aegis:Policy ;
    rdfs:label "todo-needs-ticket" ;
    aegis:targets "CodeModule" ;
    aegis:claim "for each rust line_comment matching /\\bTODO\\b/: its text matches /\\b[A-Z]+-[0-9]+\\b/" ;
    aegis:boundary "action" ;
    aegis:effect "warn" ;
    aegis:selector aegis:sel_rust_line_comments ;
    aegis:predicate aegis:pred_todo_has_ticket ;
    # SOFT, at the PAA. An untracked TODO is admissible at a cost — it is a
    # habit worth naming, not an inadmissible action — and "cost" is only
    # measurable over the edit that actually landed. Declaring it hard would
    # make `effect "warn"` a lie the graph could not detect.
    aegis:constraintClass "soft" ;
    aegis:verificationPoint "PAA" ;
    aegis:hostedAtLayer "orchestration" ;
    aegis:sourceType "operational" ;
    aegis:authority "engineering-conventions" ;
    aegis:operatingPoint aegis:op_todo_has_ticket ;
    aegis:latencyBudgetMs 10 .

# ═══════════════════════════════════════════════════════════════════
# no-ticket-in-comment — a comment must NOT carry a ticket id (must-not-match).
# effect "deny": ticket references belong in commits / PRs, not source comments.
# ═══════════════════════════════════════════════════════════════════

aegis:pred_no_ticket_in_comment a aegis:Predicate ;
    aegis:name "no-ticket-in-comment" ;
    aegis:evidenceSource "\\b[A-Z]+-[0-9]+\\b" ;
    aegis:matchType "must-not-match" ;
    aegis:tier "tree-sitter" .

aegis:op_no_ticket_in_comment a aegis:OperatingPoint ;
    aegis:kind "exact_predicate" ;
    # Hard-class asymmetry (SARC §5.2): a missed violation is by definition
    # unacceptable, a false block falls back to a human. Both are 0.0 here only
    # because the predicate is exact — an inexact hard predicate would carry a
    # tolerant FP number and a zero FN one, never the reverse.
    aegis:falsePositiveTolerance 0.0 ;
    aegis:falseNegativeTolerance 0.0 .

aegis:policy_no_ticket_in_comment a aegis:Policy ;
    rdfs:label "no-ticket-in-comment" ;
    aegis:targets "CodeModule" ;
    aegis:claim "no rust line_comment's text matches /\\b[A-Z]+-[0-9]+\\b/" ;
    aegis:boundary "action" ;
    aegis:effect "deny" ;
    aegis:selector aegis:sel_rust_line_comments ;
    aegis:predicate aegis:pred_no_ticket_in_comment ;
    # HARD, at the PAG. The text must not reach the file, so admissibility is
    # decided before dispatch; deferring it to the PAA would leave the ticket id
    # written and report it afterwards.
    aegis:constraintClass "hard" ;
    aegis:verificationPoint "PAG" ;
    # Orchestration, not tool: Hank's pre-edit hook is the host. That is the
    # honest layer — an agent that writes the file by another route is not
    # governed by this, and claiming `tool` would say otherwise.
    aegis:hostedAtLayer "orchestration" ;
    aegis:sourceType "operational" ;
    aegis:authority "engineering-conventions" ;
    aegis:operatingPoint aegis:op_no_ticket_in_comment ;
    aegis:latencyBudgetMs 5 .

# ═══════════════════════════════════════════════════════════════════
# no-ticket-in-comment v2 — the ENTITY-GROUNDED successor (design:
# docs/design/semantic-grounded-edit-policies.md). No regex: candidates are
# the tokens of the introduced text, and truth is membership in the graph's
# own work-item id set — the groundingQuery names it, the projection machinery
# serves it hot. Evaluation has THREE outcomes (grounded / unresolvable /
# no-candidate); an agent that invents QUIP-999 is caught by the graph as a
# fabricated reference, not by a reviewer.
#
# Not yet bound into a policy: the grounding-set projection and three-outcome
# evaluation are sequencing step 2 (yupana-side). The v1 pair above stays live
# until then; this predicate is the catalog's exemplar of the vocabulary so
# the shapes are exercised by shipped data, not only by fixtures.
# ═══════════════════════════════════════════════════════════════════

aegis:pred_no_ticket_in_comment_v2 a aegis:Predicate ;
    aegis:name "no-ticket-in-comment" ;
    # For a grounded predicate the evidence is the projected work-item id set
    # itself, not a pattern — provenance, per evidenceSource's contract: an
    # evaluator must be able to say WHERE the membership answer came from.
    aegis:evidenceSource "graph:work-item-id-set" ;
    # Candidates are simply the introduced text's tokens. A pattern value here
    # would be a narrowing optimization only, never authority — the id set
    # alone defines ticket-shape.
    aegis:candidateSource "token" ;
    aegis:groundingQuery "SELECT ?id WHERE { ?w a aegis:WorkItem ; aegis:identifier ?id }" ;
    aegis:matchType "must-not-ground" ;
    aegis:tier "tree-sitter+graph" .

# ═══════════════════════════════════════════════════════════════════
# VerifierRegistration — the root of trust for Hank's edit-time verdicts.
# Registers the `hank` verifier identity as authorized to attest these two
# structural predicates, so a promoted aegis:Verdict is accepted (Phase 4,
# H-PROMOTE-VERDICT). `publicKey` is omitted until Hank verdict signing lands —
# the registration is a meaningful authority record before signatures exist.
# ═══════════════════════════════════════════════════════════════════

aegis:reg_hank_structural a aegis:VerifierRegistration ;
    aegis:verifier "hank" ;
    aegis:attests "todo-needs-ticket" , "no-ticket-in-comment" .
    # A human adds hank's public key once hank's signing identity is provisioned:
    #   aegis:publicKey "<hex from `hank verifier`>" .
    # Until then this is a valid AUTHORITY record (publicKey is optional); a hank
    # verdict is accepted at write, and TRUSTED once the key is registered —
    # mirroring quipu's own "a human registers the verifier's key" model.
