        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:hostname ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── SystemdService ───────���───────────────────────────────────���───
#
# A systemd unit running on a host or container.

aegis:SystemdServiceShape a sh:NodeShape ;
    sh:targetClass aegis:SystemdService ;
    sh:property [
        sh:path aegis:port ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:healthEndpoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:healthScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 100 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── WebApplication ───────���───────────────────────────────────────
