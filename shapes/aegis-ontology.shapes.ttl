# ── Events & Software (aegis-rtht) ───────────────────────────────
#
# These four kinds are sanctioned by the extraction guide and were ALREADY IN
# THE GRAPH before they were declared here — 32 live nodes between them at the
# time of writing. They are reconciliation to the guide, not new vocabulary.
#
# Nobody noticed because nothing validated: for as long as zero shapes were
# loaded server-side (aegis-1y3q), /episode accepted them silently. The
# disagreement would first have surfaced as a validation failure on CORRECTLY
# extracted data, in the same change that turned enforcement on. Declared now,
# while enforcement is still off, so that flip stays boring.
#
# Only rdfs:label is required, per this file's own invariant (I1): a required
# predicate nothing emits is the 133-violation defect aegis-z0xi removed. The
# structured predicates below are maxCount-only — they constrain shape IF
# present and demand nothing.

# ── Incident ─────────────────────────────────────────────────────
#
# A discrete failure event with a start and (usually) an end. Bare kebab-case
# per guide §1b. Distinct from FailurePattern: an Incident HAPPENED ONCE,
# a FailurePattern RECURS. (aegis-dqn2: no similarity threshold can separate
# "Dolt" the DatabaseService from "dolt-2.1.8-drop-pk-crash" the Incident —
# which is exactly why they are different kinds and not one fuzzy pile.)

aegis:IncidentShape a sh:NodeShape ;
    sh:targetClass aegis:Incident ;
    sh:property [
        sh:path aegis:severity ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── FailurePattern ───────────────────────────────────────────────
#
# A RECURRING failure class abstracted from one or more incidents — the graph's
# most-used abstract kind (22 live nodes) and, until now, its largest undeclared
# one (aegis-49qs). Naming is `fp-<kebab>` per guide §1b; note the live graph
# already carries both `fp-`-prefixed and bare-kebab nodes, which aegis-4oeg
# tracks. Declaring the kind does NOT fix that split — a shape constrains
# properties, not identity — so do not read this block as closing 4oeg.

aegis:FailurePatternShape a sh:NodeShape ;
    sh:targetClass aegis:FailurePattern ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# Metric — RULED IN (the schema-gate call the proposal asked for): a scraped
# series is a first-class node because "which metrics exist but drive no rule?"
# is a standing operational question that wants to be queryable — proven by the
# zombie-series / noise-buried-outage incidents, where the WRONG answer to that
# question hid a 66-day outage. Label-only contract, per the R1/R2 ruling (no
# required scalar the emitters do not produce).
aegis:MetricShape a sh:NodeShape ;
    sh:targetClass aegis:Metric ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ═══ vt9m: legitimized legacy classes (label-only per the R1/R2 contract) ═══
# Each was minted before the closed vocabulary existed, audited 2026-07-23,
# and EARNED declaration: real distinct semantics, live instances, active use.
# Synonym classes were NOT declared — their instances retype to canonicals
# (PrometheusAlert->AlertRule, ConfigArtifact->ConfigFile, Repo/GitRepository->
# GitRepo, Hook->ClaudeCodeHook, and the abstract parents Host/Service are
# never emitted on instances).
# AlertRule carries the optional properties a Prometheus-style rule actually has.
# These were proposed as a separate PrometheusAlertRule class; that class is a
# synonym (see the retype list above) so the class was declined and the PROPERTIES
# adopted here instead — the useful part of that proposal was never the new name.
# guardsProducer is the one that earns its keep: it turns "which producer must
# exist for this rule to fire" from a comment in a template into a graph question,
# which is what makes an absent()-guard rule auditable.
aegis:AlertRuleShape a sh:NodeShape ;
    sh:targetClass aegis:AlertRule ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] ;
    sh:property [ sh:path aegis:alertExpr ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ;
    sh:property [ sh:path aegis:severity ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ;
    sh:property [ sh:path aegis:keeper ; sh:maxCount 1 ; ] ;
    sh:property [ sh:path aegis:guardsProducer ; sh:nodeKind sh:IRI ; ] .

aegis:TextRuleShape a sh:NodeShape ;
    sh:targetClass aegis:TextRule ;
    sh:property [ sh:path aegis:regex ; sh:minCount 1 ; ] ;
    sh:property [ sh:path aegis:enforcementTier ; sh:minCount 1 ; ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:InternalIdentifierPatternShape a sh:NodeShape ;
    sh:targetClass aegis:InternalIdentifierPattern ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:ConfigSettingShape a sh:NodeShape ;
    sh:targetClass aegis:ConfigSetting ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:SecurityFindingShape a sh:NodeShape ;
    sh:targetClass aegis:SecurityFinding ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:WorkstreamShape a sh:NodeShape ;
    sh:targetClass aegis:Workstream ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:DesignPrincipleShape a sh:NodeShape ;
    sh:targetClass aegis:DesignPrinciple ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:FeatureShape a sh:NodeShape ;
    sh:targetClass aegis:Feature ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:RequirementShape a sh:NodeShape ;
    sh:targetClass aegis:Requirement ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:LimitationShape a sh:NodeShape ;
    sh:targetClass aegis:Limitation ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:MonitoringProbeShape a sh:NodeShape ;
    sh:targetClass aegis:MonitoringProbe ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

# ── Credential (aegis-5eovj, ian 2026-08-23) ───────────────────
#
# ACCEPTED into the vocabulary after inspecting all 9 instances, per this
# repo's rule that a generic class must be justified by its nodes and not by
# its name: TELEGRAM_BOT_TOKEN_secret, prometheus-basic-auth-credential,
# homelab-mcp-ssh-key, dolt-backup-pull-key, terraform-ansible-controller-key,
# infisical-vault-access, crew-host-infisical-identity,
# homelab-mcp-ntfy-publisher, telegram_bot_8152168925.
#
# A secret or access identity is a real kind here — it has a reader path we
# already depend on (rotation runbooks, the pushgateway credential, the quipu
# bearer). SSHKey covers 3 of the 9 and is the SPECIAL case, so the hierarchy
# runs that way round rather than widening SSHKey to mean "any secret".
#
# Label floor only, deliberately: these nodes are authored by hand across
# several lanes and no emitter guarantees any other property. A shape must
# refuse nothing that already exists.
#
# ⚠️ NEVER put a credential VALUE in this graph — the class names the secret,
# it does not hold it. Nothing enforces that; it is a rule about what you write.
# Concept, Component, and Credential were accepted together after inspecting
# their live instances. Keep all three in the loaded vocabulary: omitting the
# first two made valid /episode writes succeed with an ungoverned-type advisory.
# Their producers share only the ordinary entity label contract, so stronger
# constraints would reject already-valid incremental writes.
aegis:ConceptShape a sh:NodeShape ;
    sh:targetClass aegis:Concept ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:ComponentShape a sh:NodeShape ;
    sh:targetClass aegis:Component ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:CredentialShape a sh:NodeShape ;
    sh:targetClass aegis:Credential ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:SSHKeyShape a sh:NodeShape ;
    sh:targetClass aegis:SSHKey ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:NFSExportShape a sh:NodeShape ;
    sh:targetClass aegis:NFSExport ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:APIEndpointShape a sh:NodeShape ;
    sh:targetClass aegis:APIEndpoint ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:SystemdTimerShape a sh:NodeShape ;
    sh:targetClass aegis:SystemdTimer ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:DockerContainerShape a sh:NodeShape ;
    sh:targetClass aegis:DockerContainer ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:CIWorkflowShape a sh:NodeShape ;
    sh:targetClass aegis:CIWorkflow ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:PushgatewayJobShape a sh:NodeShape ;
    sh:targetClass aegis:PushgatewayJob ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:RemoteHostShape a sh:NodeShape ;
    sh:targetClass aegis:RemoteHost ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:FailureModeShape a sh:NodeShape ;
    sh:targetClass aegis:FailureMode ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:OperationalFactShape a sh:NodeShape ;
    sh:targetClass aegis:OperationalFact ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:MLModelShape a sh:NodeShape ;
    sh:targetClass aegis:MLModel ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:DataCorpusShape a sh:NodeShape ;
    sh:targetClass aegis:DataCorpus ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

aegis:TraefikRouteShape a sh:NodeShape ;
    sh:targetClass aegis:TraefikRoute ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] .

# ── ExternalService ──────────────────────────────────────────────
#
# A third-party service we CONSUME but do not operate: MusicBrainz, ListenBrainz,
# Discogs, Spotify. Modelled because consuming one carries obligations we need to
# be able to query (rate limits enforced by blocking, contact-carrying User-Agent
# requirements, optional tokens that only raise a quota).
#
# DELIBERATELY NOT rdfs:subClassOf aegis:Service. The Service hierarchy answers
# "what do we RUN" — every existing child (SystemdService, WebApplication,
# DatabaseService, SearchService) is something we operate. Filing consumed
# third-party dependencies under it would silently inflate every "our services"
# query with things we neither run nor can fix. This is not hypothetical: because
# a constant-IRI type query resolves subclasses, `?s a aegis:Service` already
# returns ~6x the directly-asserted count, and every child added widens that gap
# for every caller. We do not add a fifth child to widen it further.
# If a "everything we depend on, ours or not" query is ever wanted, it wants its
# own parent, not a reuse of this one.

aegis:ExternalServiceShape a sh:NodeShape ;
    sh:targetClass aegis:ExternalService ;
    sh:property [
        sh:path aegis:externalUrl ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

# ═══ vt9m: the declared class hierarchy (also asserted as graph data) ═══
# Abstract parents Host and Service exist ONLY as query targets via the
# hierarchy — never emit them on an instance (guide §2).
aegis:ProxmoxNode rdfs:subClassOf aegis:Host .
aegis:BareMetalHost rdfs:subClassOf aegis:Host .
aegis:LXCContainer rdfs:subClassOf aegis:Host .
aegis:SystemdService rdfs:subClassOf aegis:Service .
aegis:WebApplication rdfs:subClassOf aegis:Service .
aegis:DatabaseService rdfs:subClassOf aegis:Service .
aegis:SearchService rdfs:subClassOf aegis:Service .
aegis:ClaudeCodeHook rdfs:subClassOf aegis:Script .
aegis:AlertRule rdfs:subClassOf aegis:Directive .
aegis:SSHKey rdfs:subClassOf aegis:Credential .

# ⚠️ READ THE PARENTHESIS IN THE HEADER ABOVE — IT IS THE WHOLE MECHANISM.
#
# "(also asserted as graph data)" is not a note, it is the load-bearing half.
# Subclass expansion reads the FACTS TABLE, never this file: `collect_class_and
# _subclasses` (src/sparql/rdfs.rs) does `SELECT e FROM facts WHERE a = subClassOf`.
# Loading a shapes file puts it in the SHAPES table, which drives SHACL validation
# and nothing else. So an axiom that lives ONLY here is inert — `?s a Parent` will
# not return the child, and no error says so.
#
# MEASURED 2026-08-04, and it has already bitten: shapes/governance.ttl
# declares `aegis:Decision rdfs:subClassOf aegis:DecisionRecord` and
# `aegis:Verdict rdfs:subClassOf aegis:Observation` on two ADJACENT lines with the
# comment "so the parent's shape ALSO applies to the child via inference". Both were
# absent from the facts table; `?s a DecisionRecord` applied no inference at all and
# missed its Decision instance. Their neighbour `aegis:Policy` worked — same file,
# same commit — which is exactly why the failure was invisible.
#
# So: adding a line HERE changes nothing on its own. Assert it too:
#   POST /knot {"actor":"<you>","turtle":"@prefix aegis: … rdfs:subClassOf … ."}
# then PROVE it by expansion, not by re-reading the file:
#   ?s a <Parent>  ->  the response's `inference.expandedTypes` must name the child.

# ── Retired the hand dual-typing convention ─────────────────────
#
# Descriptive defect knowledge had no common parent, so a reader asking
# `?s a Directive` silently missed every FailureMode — and the documented answer
# was to hand dual-type each node forever. These two axiom sets replace that
# discipline. FailureMode is deliberately NOT a subclass of Directive: a defect is
# not a rule, and asserting it would both be false and flood Directive with ~250
# descriptive nodes.
aegis:FailureKnowledge rdfs:subClassOf aegis:OperationalKnowledge .
aegis:FailureMode rdfs:subClassOf aegis:FailureKnowledge .
aegis:FailurePattern rdfs:subClassOf aegis:FailureKnowledge .
aegis:IncidentClass rdfs:subClassOf aegis:FailureKnowledge .
aegis:Directive rdfs:subClassOf aegis:OperationalKnowledge .

# ── Asserted in the store before they were ever written down ─────
#
# These 12 were asserted via /set and were live for a day with no
# file recording them. Written here so the declared hierarchy is reviewable in one
# place — NOT because writing them here is what makes them work. See the warning
# above: they work because they are in the facts table.
aegis:AgentTool rdfs:subClassOf aegis:Tool .
aegis:CLI rdfs:subClassOf aegis:Tool .
aegis:CLITool rdfs:subClassOf aegis:CLI .
aegis:Container rdfs:subClassOf aegis:Host .
aegis:RemoteHost rdfs:subClassOf aegis:Host .
aegis:DockerContainer rdfs:subClassOf aegis:Host .
aegis:DecisionRecord rdfs:subClassOf aegis:Document .
aegis:DesignDoc rdfs:subClassOf aegis:Document .
aegis:ExternalService rdfs:subClassOf aegis:Service .
aegis:OperationalRule rdfs:subClassOf aegis:Directive .
aegis:Procedure rdfs:subClassOf aegis:Directive .
aegis:InternalIdentifierPattern rdfs:subClassOf aegis:TextRule .

# ── De-facto vocabulary, governed ────────────────────────────────
#
# Three kinds that earned their way in by USAGE and had no shape: Host (66
# instances), OperationalRule (28), Capability (7). They are not one author's
# typos — they span many episodes over months — so the disposition is to GOVERN
# them, not to retract the instances. (FailureMode was the fourth and is already
# governed; do not re-add it.)
#
# Each requires only rdfs:label, which is this file's floor for any entity and is
# NOT a tightening: MEASURED before landing, all 101 instances across the three
# already carry a label (66/66, 28/28, 7/7), so these shapes refuse nothing that
# exists. Shapes here enforce on every write, so an untested constraint would
# start bouncing legitimate data — hence the floor and the measurement, with any
# real tightening left to a deliberate pass.
#
# Modelling calls, made rather than deferred:
#
#   Host — a SUPERCLASS, not redundant. Six children already resolve to it
#   (ProxmoxNode, BareMetalHost, LXCContainer, Container, RemoteHost,
#   DockerContainer), so `?s a Host` already expands to the whole population and
#   retyping its direct instances away would break that. Shaping the parent is one
#   of the two sanctioned remedies for an unshaped abstract parent.
#
#   OperationalRule — kept DISTINCT and subclassed under Directive (asserted
#   above). It was already reachable from a Directive query while unvalidated,
#   which is the retrievability trap in reverse: covered to a reader, ungoverned
#   in fact.
#
#   Capability — kept DISTINCT from AgentTool. The original proposal said the two
#   overlapped, citing verify_release; MEASURED, none of the seven current
#   Capability instances carries AgentTool. They name what the system CAN DO
#   (crew-only-guard, st-stalled-detector, skein-dispatch-work-skill), which is
#   not the same claim as a tool an agent invokes. Folding them would assert an
#   overlap the data does not show.

aegis:HostShape a sh:NodeShape ;
    sh:targetClass aegis:Host ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

aegis:OperationalRuleShape a sh:NodeShape ;
    sh:targetClass aegis:OperationalRule ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

aegis:CapabilityShape a sh:NodeShape ;
    sh:targetClass aegis:Capability ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── The last two asserted abstract parents ───────────────────────
#
# Service (65 direct assertions) and Tool (18) were the remaining classes
# reported by invariant I8: a parent with children and no shape of its own, so a
# node typed with the PARENT is governed by nothing while `?s a Service` returns
# it anyway. Shaping them is the second of I8's two sanctioned remedies, and it
# is the SAME call ec1f082 made for Host directly above — made the same way,
# from the same measurement, so the two do not have to be argued separately.
#
# Why shape rather than retype, per class, MEASURED not assumed:
#
#   Service — five children already resolve to it (WebApplication,
#   DatabaseService, SystemdService, SearchService, ExternalService), so the
#   constant-IRI query already expands to 370 while only 65 are asserted.
#   Retyping those 65 away would break that expansion for the ones that are
#   genuinely just "a service" and nothing narrower — 26 of the 65 carry no
#   other type at all, which is the population a child class does not exist for.
#
#   Tool — same shape, smaller: children CLI and AgentTool, 18 asserted, 11 of
#   them bare. The bare ones are guards, skills and probes (dangerous-command-
#   guard, hank-census, st_doctor); "a tool" is the honest claim for those and
#   inventing a child to hold them would be modelling for the checker's benefit.
#
# NOT a tightening, and measured before landing exactly as ec1f082 required:
# 65/65 Service and 18/18 Tool instances already carry rdfs:label, so these two
# shapes refuse nothing that exists. The asserted counts come from the FILTER
# form (`?s a ?c . FILTER(?c = <...>)`); the constant form expands over
# subClassOf and would have reported 370 — see the note on I8 in
# verify_shape_invariants.py.
#
# Landing these takes I8's direct-assertion count to ZERO, which is the trigger
# its own docstring names for promoting it from a REPORT to a FAILURE. That flip
# is in the same change, because the report is what let the backlog re-grow.

aegis:ServiceShape a sh:NodeShape ;
    sh:targetClass aegis:Service ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

aegis:ToolShape a sh:NodeShape ;
    sh:targetClass aegis:Tool ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── SoftwareVersion ──────────────────────────────────────────────
#
# A specific released version of a piece of software, so an incident can point
# at the version that carried it rather than at the product in general.

aegis:SoftwareVersionShape a sh:NodeShape ;
    sh:targetClass aegis:SoftwareVersion ;
    sh:property [
        sh:path aegis:version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── StoragePool ──────────────────────────────────────────────────
#
# A backing storage pool (e.g. fastpool). Distinct from ZFSDataset: a dataset
# lives IN a pool.

aegis:StoragePoolShape a sh:NodeShape ;
    sh:targetClass aegis:StoragePool ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── ClaudeCodeHook ───────────────────────────────────────────────
#
# A Claude Code hook — a PreToolUse/Stop/SessionStart entry wired into a
# settings.json. Declared because it was IN USE and undeclared (4 nodes:
# gt-tap-guard, graph-capture-hook, quipu-session-capture.sh,
# crew-only-guard.sh) — an aegis-rt9c I6 instance, found by ruling on
# aegis-gljx rather than by any check.
#
# THIS IS THE CANONICAL KIND FOR A GUARD, and aegis:Guard was deliberately NOT
# declared. Guard-ness is a ROLE, not a kind: the live graph realizes it as
# ClaudeCodeHook, CLI, Script, Directive, SystemdService and DesignDoc. A Guard
# class would have become a SEVENTH way to type a guard while consolidating
# none of them. Type a guard by WHAT IT IS; say that it guards with an edge.

aegis:ClaudeCodeHookShape a sh:NodeShape ;
    sh:targetClass aegis:ClaudeCodeHook ;
    sh:property [
        sh:path aegis:event ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Relationship Constraints — WIRED 2026-07-23 (was: inert by construction)
# ═══════════════════════════════════════════════════════════════════
#
# Every shape below is TARGETED (sh:targetSubjectsOf) and annotated
# quipu:onViolation "emit" — on a binary with event P3, violations become
# shacl.violation events without gating the write; on the current deployed
# binary the annotation is inert and enforcement is reject, which is SAFE
# because every wired shape was measured at ZERO live violations first
# (ranges widened to cover legitimate emergent usage; three data-bug edges
# repaired; the un-wireable four held below).
#
# RANGE WIDENINGS, each from measurement of live usage (not guesswork):
#   member_of    += AnsibleGroup (declared-layer host groups, 40 edges), Skill
#   committed_to += GitRepository, Repo (the class-name drift family, vt9m)
#   authored_by  += Polecat (historical polecat-era authors)
#   triggered_by += GitCommit (bead provenance), CLI (tool-invoked scripts)
#
# STILL UNWIRED — HELD, with the measured blocker for each (fmt5-class
# semantic-migration work, not range tweaks):
#   runs_on       12/118 mixed: direction-inverted edges (container runs_on app)
#                 + substrate usage (X runs_on ZFSDataset)
#   managed_by    23/35 multi-sense: directive-governs (should be applies_to,
#                 inverted) + component-of (should be part_of) alongside the
#                 canonical person/role senses
#   implements    7/27 multi-sense: code-implements-service, doc-implements-design
#   configured_in 9/13 direction-drift: config-file -> consumer (inverted from
#                 the canonical "thing configured_in file")

aegis:RunsOnShape a sh:PropertyShape ;
    # HELD — see section header. No target on purpose.
    sh:path aegis:runs_on ;
    sh:or (
        [ sh:class aegis:ProxmoxNode ]
        [ sh:class aegis:BareMetalHost ]
        [ sh:class aegis:LXCContainer ]
    ) .

aegis:ManagedByShape a sh:PropertyShape ;
    # HELD — see section header. No target on purpose.
    sh:path aegis:managed_by ;
    sh:or ( [ sh:class aegis:CrewMember ] [ sh:class aegis:Person ] ) .

aegis:ImplementsShape a sh:PropertyShape ;
    # HELD — see section header. No target on purpose.
    sh:path aegis:implements ;
    sh:class aegis:Bead .

aegis:ConfiguredInShape a sh:PropertyShape ;
    # HELD — see section header. No target on purpose.
    sh:path aegis:configured_in ;
    sh:or ( [ sh:class aegis:ConfigFile ] [ sh:class aegis:AnsibleRole ] ) .

aegis:MemberOfShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:member_of ;
    sh:property [
        sh:path aegis:member_of ;
        sh:or ( [ sh:class aegis:Rig ] [ sh:class aegis:AnsibleGroup ] [ sh:class aegis:Skill ] ) ;
    ] .

aegis:ReportsToShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:reports_to ;
    sh:property [ sh:path aegis:reports_to ; sh:class aegis:CrewMember ; ] .

# WIRED at birth: measured 0 live aegis:hasRole edges and 0
# aegis:CrewRole instances before wiring, so the zero-violations precondition
# in the section header holds trivially. Wiring a predicate on the day it is
# minted is the only moment that precondition is free — after usage accretes
# it costs a migration, which is how the four HELD shapes above got stuck.
aegis:HasRoleShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:hasRole ;
    sh:property [ sh:path aegis:hasRole ; sh:class aegis:CrewRole ; ] .

aegis:CommittedToShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:committed_to ;
    sh:property [
        sh:path aegis:committed_to ;
        sh:or ( [ sh:class aegis:GitRepo ] [ sh:class aegis:GitRepository ] [ sh:class aegis:Repo ] ) ;
    ] .

aegis:AuthoredByShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:authored_by ;
    sh:property [
        sh:path aegis:authored_by ;
        sh:or ( [ sh:class aegis:Person ] [ sh:class aegis:CrewMember ] [ sh:class aegis:Polecat ] ) ;
    ] .

aegis:TriggeredByShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:triggered_by ;
    sh:property [
        sh:path aegis:triggered_by ;
        sh:or ( [ sh:class aegis:CronJob ] [ sh:class aegis:Script ] [ sh:class aegis:GitCommit ] [ sh:class aegis:CLI ] ) ;
    ] .

# The ten structure-only relationship guards: objects must be IRIs (an entity
# edge to a literal is a typo'd fact that reads like a fact — measured zero
# live literals on all ten before wiring, so these are true-and-armed).
aegis:DependsOnShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:depends_on ;
    sh:property [ sh:path aegis:depends_on ; sh:nodeKind sh:IRI ; ] .

aegis:ConnectsToShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:connects_to ;
    sh:property [ sh:path aegis:connects_to ; sh:nodeKind sh:IRI ; ] .

aegis:BacksUpShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:backs_up ;
    sh:property [ sh:path aegis:backs_up ; sh:nodeKind sh:IRI ; ] .

aegis:RoutesToShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:routes_to ;
    sh:property [ sh:path aegis:routes_to ; sh:nodeKind sh:IRI ; ] .

aegis:MonitorsShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:monitors ;
    sh:property [ sh:path aegis:monitors ; sh:nodeKind sh:IRI ; ] .

aegis:AppliesToShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:applies_to ;
    sh:property [ sh:path aegis:applies_to ; sh:nodeKind sh:IRI ; ] .

aegis:DerivedFromShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:derived_from ;
    sh:property [ sh:path aegis:derived_from ; sh:nodeKind sh:IRI ; ] .

aegis:DeployedOnShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:deployed_on ;
    sh:property [ sh:path aegis:deployed_on ; sh:nodeKind sh:IRI ; ] .

aegis:OwnsShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:owns ;
    sh:property [ sh:path aegis:owns ; sh:nodeKind sh:IRI ; ] .

aegis:ModifiesShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:targetSubjectsOf aegis:modifies ;
    sh:property [ sh:path aegis:modifies ; sh:nodeKind sh:IRI ; ] .
