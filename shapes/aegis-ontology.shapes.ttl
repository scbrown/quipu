# ── ReverseProxyRoute ─────��────────────────────────────────────��─
#
# A Traefik route mapping hostname to backend.

aegis:ReverseProxyRouteShape a sh:NodeShape ;
    sh:targetClass aegis:ReverseProxyRoute ;
    sh:property [
        sh:path aegis:hostname ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:backend ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        # VALUE QUALITY, not mere presence — the first such constraint here.
        # 60 of 61 backend facts were once UNEXPANDED JINJA ("http://{{ ... }}"):
        # the ingest read the ansible TEMPLATE and stored the placeholder as the
        # service address, and every count/coverage check read green. A backend
        # must be a concrete address; any brace means a template leaked through.
        # (minCount deliberately still absent: 61/63 coverage — 2 routes carry
        # no backend, so requiring it needs those triaged first, and I1 amended.)
        sh:pattern "^https?://[^{]+$" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── NetworkSegment ───────────────────────────────────────────────
#
# A VLAN, subnet, or DNS zone.

aegis:NetworkSegmentShape a sh:NodeShape ;
    sh:targetClass aegis:NetworkSegment ;
    sh:property [
        sh:path aegis:subnet ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:gateway ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:purpose ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

