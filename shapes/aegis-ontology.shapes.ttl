# SHACL shapes for the aegis homelab ontology.
#
# Defines validation constraints for all entity labels and relationships
# in the ontology extraction guide (docs/ontology-extraction-guide.md).
#
# Load via POST /shapes:
#   curl -s localhost:3030/shapes -X POST \
#     -H "Content-Type: application/json" \
#     -d '{"action": "load", "name": "aegis-ontology", "turtle": "<contents>"}'

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quipu:  <http://quipu.dev/ontology/> .
@prefix aegis:  <http://aegis.gastown.local/ontology/> .

# ═══════════════════════════════════════════════════════════════════
# Global Constraints
# ═══════════════════════════════════════════════════════════════════

# All aegis entities must have at least one rdfs:label.
aegis:LabelRequiredShape a sh:NodeShape ;
    sh:targetSubjectsOf aegis:runs_on, aegis:depends_on, aegis:managed_by,
        aegis:member_of, aegis:owns, aegis:monitors, aegis:routes_to,
        aegis:connects_to, aegis:deployed_on ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ════════��══════════════════════════════════════════════════════════
# Infrastructure
# ═════════════════════════════���═════════════════════════════════════

# ── LXCContainer ──────────────────────────────────────────────────
#
# A Proxmox LXC container. Must have a container ID, IP address,
# and hostname.

aegis:LXCContainerShape a sh:NodeShape ;
    sh:targetClass aegis:LXCContainer ;
    sh:property [
        sh:path aegis:ctId ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:ipAddress ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:hostname ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── ProxmoxNode ────────��────────────────────────────────────��────
#
# A physical Proxmox host (e.g., koror, kota).

aegis:ProxmoxNodeShape a sh:NodeShape ;
    sh:targetClass aegis:ProxmoxNode ;
    sh:property [
        sh:path aegis:nodeId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:role ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── BareMetalHost ─────────────────────────────────────────��──────
#
# A non-Proxmox host (e.g., luvu, a Pi).

aegis:BareMetalHostShape a sh:NodeShape ;
    sh:targetClass aegis:BareMetalHost ;
    sh:property [
        sh:path aegis:ipAddress ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:hostname ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── SystemdService ───────���───────────────────────────────────���───
#
# A systemd unit running on a host or container.

aegis:SystemdServiceShape a sh:NodeShape ;
    sh:targetClass aegis:SystemdService ;
    sh:property [
        sh:path aegis:port ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:healthEndpoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:healthScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 100 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── WebApplication ───────���───────────────────────────────────────
#
# An HTTP-serving service (Tapestry, Forgejo, Grafana, etc.).

aegis:WebApplicationShape a sh:NodeShape ;
    sh:targetClass aegis:WebApplication ;
    sh:property [
        sh:path aegis:externalUrl ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── DatabaseService ──��───────────────────────────────────────���───
#
# A data store (PostgreSQL, FalkorDB, Dolt, etc.).

aegis:DatabaseServiceShape a sh:NodeShape ;
    sh:targetClass aegis:DatabaseService ;
    sh:property [
        sh:path aegis:dataPath ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:storageBackend ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── SearchService ────────────────────────────────────────────────
#
# A search/indexing service (bobbin). Declared rdfs:subClassOf
# aegis:Service like its three siblings above, but it was the ONLY
# declared subclass — of any parent — with no sh:targetClass
# (aegis-19gip). It stayed invisible because the inference-expanded
# Service count swallowed it: asking `?s a aegis:Service` returns it
# already, so coverage looked complete from every angle that counted
# the parent. Its siblings are shaped; a declared child that is not
# is unshaped emission by the I5 rule, one level down.
#
# Optional-only beyond rdfs:label, per I1: aegis:indexes is emitted
# on the live instance, aegis:externalUrl is not universal.

aegis:SearchServiceShape a sh:NodeShape ;
    sh:targetClass aegis:SearchService ;
    sh:property [
        sh:path aegis:indexes ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── ZFSDataset ─────────────────────────────────────���─────────────
#
# A ZFS dataset for storage.

aegis:ZFSDatasetShape a sh:NodeShape ;
    sh:targetClass aegis:ZFSDataset ;
    sh:property [
        sh:path aegis:pool ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:mountpoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── ReverseProxyRoute ─────��────────────────────────────────────��─
#
# A Traefik route mapping hostname to backend.

aegis:ReverseProxyRouteShape a sh:NodeShape ;
    sh:targetClass aegis:ReverseProxyRoute ;
    sh:property [
        sh:path aegis:hostname ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:backend ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        # VALUE QUALITY, not mere presence — the first such constraint here.
        # 60 of 61 backend facts were once UNEXPANDED JINJA ("http://{{ ... }}"):
        # the ingest read the ansible TEMPLATE and stored the placeholder as the
        # service address, and every count/coverage check read green. A backend
        # must be a concrete address; any brace means a template leaked through.
        # (minCount deliberately still absent: 61/63 coverage — 2 routes carry
        # no backend, so requiring it needs those triaged first, and I1 amended.)
        sh:pattern "^https?://[^{]+$" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── NetworkSegment ───────────────────────────────────────────────
#
# A VLAN, subnet, or DNS zone.

aegis:NetworkSegmentShape a sh:NodeShape ;
    sh:targetClass aegis:NetworkSegment ;
    sh:property [
        sh:path aegis:subnet ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:gateway ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:purpose ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ════════════════════════════════════════��══════════════════════════
# Agent Platform
# ═════════��═════════════════════════════════════════════════════════

# ── AgentTool ────────────────────────────────────────────────────
#
# A tool in the agent platform (parent of CLI, MCPServer).

aegis:AgentToolShape a sh:NodeShape ;
    sh:targetClass aegis:AgentTool ;
    sh:property [
        sh:path aegis:sourceRepo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:providesCommand ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── Rig ─────────��──────────────────────────��─────────────────────
#
# A gastown rig (aegis, quipu, bobbin, etc.).

aegis:RigShape a sh:NodeShape ;
    sh:targetClass aegis:Rig ;
    sh:property [
        sh:path aegis:prefix ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:purpose ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── CrewMember ───────────────────────────────────────────────────
#
# A crew agent (malcolm, goldblum, ellie, etc.).

aegis:CrewMemberShape a sh:NodeShape ;
    sh:targetClass aegis:CrewMember ;
    sh:property [
        # SUPERSEDED by aegis:hasRole. Kept for the migration
        # window: role was one closed enum value doubling as tree-position.
        # Drop only once every member carries hasRole.
        sh:path aegis:role ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # The role SET — no maxCount on purpose. A member stacks several
        # (arnold: worker + keeper + escalation-target).
        sh:path aegis:hasRole ;
        sh:class aegis:CrewRole ;
    ] ;
    sh:property [
        sh:path aegis:tier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:domain ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Non-live CrewMembers (ruled 2026-07-23, teyk residue 1): a node that
        # is historically a crew member but must NOT appear in live-agent
        # projections carries crewStatus. ABSENCE means live/active — chosen
        # for its failure asymmetry: forgetting to mark someone retired shows
        # a stale card (visible, annoying); the inverse convention would hide
        # a live agent (invisible, dangerous — that is how a live agent
        # vanished from st during the teyk retract). "retired" = was real
        # (strider, walker); "never-instantiated" = typed by directive/context
        # episodes but no such process ever ran on this host (mayor — a card
        # for it recreates the black-hole dispatch target).
        sh:path aegis:crewStatus ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ("retired" "never-instantiated") ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── ResponsibilityDomain ─────────────────────────────────────────
#
# An area of standing responsibility a crew member owns (iac, comms,
# security-signoff) — abstract, not a service or host. Minted 2026-07-23
# (teyk residue 3): the ownership facts malcolm->iac, ellie->comms,
# sentinel->security-signoff previously hung off UNTYPED nodes whose only
# typing arrived incidentally and was lost in a retract. Naming rule:
# bare kebab (guide 1b, unlisted-kind rule -> this row).

aegis:ResponsibilityDomainShape a sh:NodeShape ;
    sh:targetClass aegis:ResponsibilityDomain ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── CrewRole ─────────────────────────────────────────────────────
#
# A composable trait-preset a CrewMember can hold. NOT an
# aegis:AnsibleRole — that is an IaC role, a different plane entirely.
#
# WHY A CLASS AND NOT MORE ENUM VALUES: st's tier.py carries
# VALID_ROLES = worker|lead|administrator, where role IS tree-position. The
# crew already runs roles that cannot be said in that enum — an advisor is
# UNATTACHED (no reports_to, no reportees) and so fails tier.py's reports-to
# validation outright; a keeper is domain-scoped with an in-domain veto; and
# a member holds SEVERAL at once (arnold ran worker + keeper + escalation-
# target). So a role is a named preset over six orthogonal axes, and a
# member's effective traits are the UNION across the roles it holds
# (single-valued axes: most-specific wins; multi-valued: set-union).
#
# The axes are prefixed `trait` on purpose. aegis:authority is already the
# Stiwi-authority of an aegis:Directive and aegis:roleName is already the
# name of an aegis:AnsibleRole; reusing either would conflate two planes in
# one predicate and quietly poison `?x aegis:roleName ?n` for both.
#
# Parameters that vary PER MEMBER — which domain a keeper owns, which lead a
# worker reports to — stay on the CrewMember (aegis:domain, aegis:reports_to)
# and never on the role, so a role stays reusable across members.
#
# Only rdfs:label is required, per I1: a sh:minCount must follow a proven
# emitter, never precede one. crewRoleName is the machine slug st carries in
# ST_ROLES, and stays optional until something demonstrably emits it.

aegis:CrewRoleShape a sh:NodeShape ;
    sh:targetClass aegis:CrewRole ;
    sh:property [
        sh:path aegis:crewRoleName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Is it in the tree at all? `unattached` is what makes an advisor
        # legal — the admin skips the reports-to rules entirely for it.
        sh:path aegis:traitAttachment ;
        sh:in ( "rooted" "reports-to" "unattached" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # MULTI on purpose — a worker is dispatched AND self-directed.
        sh:path aegis:traitWorkIntake ;
        sh:in ( "dispatched" "self-directed" "consulted" "escalations-only" "none" ) ;
    ] ;
    sh:property [
        # MULTI on purpose — a lead absorbs AND dispatches.
        sh:path aegis:traitCoordination ;
        sh:in ( "absorbs" "dispatches" "neither" ) ;
    ] ;
    sh:property [
        sh:path aegis:traitScope ;
        sh:in ( "fleet-wide" "domain-scoped" "single-task" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:traitLifecycle ;
        sh:in ( "persistent" "ephemeral" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:traitAuthority ;
        sh:in ( "veto-in-scope" "gate" "none" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── TraitValue — precedence for the SINGLE-VALUED CrewRole axes ──
#
# THE PROBLEM. A CrewRole's MULTI axes (traitWorkIntake, traitCoordination)
# compose by set-union — unambiguous. The SINGLE-valued axes (traitAttachment,
# traitScope, traitLifecycle, traitAuthority) do NOT: when a member stacks roles
# that disagree, e.g. keeper(scope=domain-scoped, authority=veto-in-scope) +
# worker(scope=single-task, authority=none), nothing in the data says which wins.
# The prior design prose said "most-specific/most-privileged wins" — but prose is not
# computable, so every admin would hardcode a tie-break, which is the closed-enum
# problem reappearing one layer up (the exact thing composable roles killed).
#
# THE RULE. Each single-valued axis has a TOTAL ORDER over its values, declared
# as DATA (one aegis:TraitValue per (axis,value) with an integer aegis:precedence).
# The effective value for a member = the value with the MAX precedence across the
# member's roles on that axis. Set as data, NOT as sh:in list position — implicit
# ordering inside a validation construct is invisible to a reader and silently
# reorderable (called out on the bead as the thing NOT to do).
#
# WHY MAX IS RIGHT PER AXIS (each is a genuine ladder, not an arbitrary pick):
#   attachment  rooted > reports-to > unattached  — ANY attached role makes the
#     member attached; unattached only wins when ALL roles are unattached, which
#     is exactly the condition that legitimately skips the tier.py reports-to check.
#   scope       fleet-wide > domain-scoped > single-task — broadest reach a member
#     holds is real reach; an administrator who also holds a single-task role is
#     still fleet-wide.
#   authority   veto-in-scope > gate > none — most-privileged authority the member
#     holds is the one it can exercise.
#   lifecycle   persistent > ephemeral — a member with any persistent role persists.
#
# NOTE this shapes the value-ranking rows; the MULTI axes need no TraitValue rows
# (set-union has no tie to break). Only rdfs:label required, per invariant I1.

aegis:TraitValueShape a sh:NodeShape ;
    sh:targetClass aegis:TraitValue ;
    sh:property [
        sh:path aegis:axis ;
        sh:datatype xsd:string ;
        sh:in ( "attachment" "scope" "authority" "lifecycle" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:traitValue ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:precedence ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── DesiredCrewShape / DesiredCrewSlot ──────────────────────────
#
# Declarative input to the admin-owned crew-reconcile skill. This is the
# DESIRED plane; CrewMember + reports_to remain the observed/live plane. st
# supplies atomic mechanisms only after an administrator compares the two.
#
# A plan owns total target and scope; slots own composition. Slots reuse
# CrewRole so survival and precedence remain existing role-catalogue DATA.
# Completeness, cross-node arithmetic, one-active-plan-per-scope, and cycle
# checks belong to reconciliation. I1 permits no required non-label property
# before an emitter is proven, and core SHACL cannot express the latter checks
# without SPARQL constraints. The skill therefore REFUSES an incomplete active
# plan; SHACL constrains every value that is present.

aegis:DesiredCrewShapeShape a sh:NodeShape ;
    sh:targetClass aegis:DesiredCrewShape ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] ;
    sh:property [
        sh:path aegis:crewPlanStatus ;
        sh:in ( "draft" "active" "retired" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:scopeKind ;
        sh:in ( "fleet" "rig" "group" "lane" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Omit only for fleet scope. Rig/group/lane plans point at the graph
        # entity being planned; the reconciler enforces that conditional.
        sh:path aegis:scopeEntity ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:targetSize ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:hasCrewSlot ; sh:class aegis:DesiredCrewSlot ;
    ] .

aegis:DesiredCrewSlotShape a sh:NodeShape ;
    sh:targetClass aegis:DesiredCrewSlot ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; ] ;
    sh:property [
        # Multi-valued: slots can require composable roles. Harness, survival
        # and precedence are resolved from those role facts, not redefined.
        sh:path aegis:requiresRole ; sh:class aegis:CrewRole ;
    ] ;
    sh:property [
        sh:path aegis:desiredCount ; sh:datatype xsd:integer ;
        sh:minInclusive 0 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        # A root says minimumCount=1 and elastic=false; it cannot satisfy a
        # smaller target by disappearing. targetSize includes this floor.
        sh:path aegis:minimumCount ; sh:datatype xsd:integer ;
        sh:minInclusive 0 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:elastic ; sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Current policy is lead=claude, worker=codex; keeping it as data lets
        # the policy change without changing st or the reconciliation skill.
        sh:path aegis:desiredHarness ;
        sh:in ( "claude" "codex" ) ; sh:maxCount 1 ;
    ] ;
    sh:property [
        # Desired hierarchy between slots. Root slots omit it.
        sh:path aegis:reportsToSlot ; sh:class aegis:DesiredCrewSlot ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Destination for duties when this slot sheds capacity. Omit where
        # consolidation requires fresh administrator judgment.
        sh:path aegis:consolidatesInto ; sh:class aegis:DesiredCrewSlot ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:domain ; sh:datatype xsd:string ; sh:maxCount 1 ;
    ] .

# ── Polecat ──────────────���───────────────────────────────────────
#
# A worker agent dispatched to execute a formula.

aegis:PolecatShape a sh:NodeShape ;
    sh:targetClass aegis:Polecat ;
    sh:property [
        sh:path aegis:rig ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:status ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── CLI ─────────��───────────────────────────���────────────────────
#
# A command-line tool (gt, bd, bobbin, etc.).

aegis:CLIShape a sh:NodeShape ;
    sh:targetClass aegis:CLI ;
    sh:property [
        sh:path aegis:binary ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── MCPServer ────────────────���─────────────────────────────��─────
#
# An MCP server providing tools to agents.

aegis:MCPServerShape a sh:NodeShape ;
    sh:targetClass aegis:MCPServer ;
    sh:property [
        sh:path aegis:port ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:tools ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── Plugin ─────────��──────────────────────────��──────────────────
#
# A gastown plugin (marshal, witness, refinery, etc.).

aegis:PluginShape a sh:NodeShape ;
    sh:targetClass aegis:Plugin ;
    sh:property [
        sh:path aegis:pluginType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:triggers ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── Skill ──────────────��──────────────────────────────────��──────
#
# A Claude Code skill available to agents.

aegis:SkillShape a sh:NodeShape ;
    sh:targetClass aegis:Skill ;
    sh:property [
        sh:path aegis:skillName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] .

# ── Formula ────��─────────────────────────────────────────────────
#
# A molecule template defining a polecat workflow.

aegis:FormulaShape a sh:NodeShape ;
    sh:targetClass aegis:Formula ;
    sh:property [
        sh:path aegis:formulaName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
