# SHACL shapes for the Governance Plane ("the loom") — policy, workflows &
# verification, layered on the Hank x Quipu x Bobbin stack.
#
# Implements the "Entities in Quipu" contract from the governance-plane design
# (hank docs/book/src/design/governance-plane.md, Phase 1). The primitives are
# RDF classes in Quipu's governed ontology, so **definition-time verification is
# just SHACL over them** — a workflow/policy/step definition that violates its
# shape is rejected at write. The governance classes EXTEND the code-entities
# ontology (CodeModule, CodeSymbol, Document, Section, Bundle) in the SAME
# namespace, so governance facts and code facts live in one graph and answer a
# single SPARQL query.
#
# Reuse over invention (per the design's table): Policy extends Directive;
# Verdict is an Observation; Decision is a DecisionRecord. These already exist in
# aegis-ontology.shapes.ttl — here we subclass them (RDFS) and add the
# governance-specific constraints.
#
# Load via POST /shapes:
#   curl -s localhost:3030/shapes -X POST -H "Content-Type: application/json" \
#     -d '{"action":"load","name":"governance","turtle":"<contents>"}'

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix aegis:  <http://aegis.gastown.local/ontology/> .

# ═══════════════════════════════════════════════════════════════════
# Class hierarchy — reuse the existing governance types (RDFS subclass,
# so the parent's shape ALSO applies to the child via inference).
# ═══════════════════════════════════════════════════════════════════

aegis:Policy   rdfs:subClassOf aegis:Directive .       # governed rule / intent
aegis:Verdict  rdfs:subClassOf aegis:Observation .     # signed, content-bound result
aegis:Decision rdfs:subClassOf aegis:DecisionRecord .  # human approve / reject / changes

# ═══════════════════════════════════════════════════════════════════
# Composition types — the workflow graph.
# ═══════════════════════════════════════════════════════════════════

# ── Workflow ───────────────────────────────────────────────────────
# A directed graph of Steps + guarded Transitions. Must be named and hold
# at least one Step (the entry). Acyclicity/coverage are checked by the
# creation-is-verified pass, not expressible in core SHACL.

aegis:WorkflowShape a sh:NodeShape ;
    sh:targetClass aegis:Workflow ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:hasStep ;
        sh:class aegis:Step ;
        sh:minCount 1 ;
    ] .

# ── Step ───────────────────────────────────────────────────────────
# One unit of work: { produces: [Artifact], requires: [Artifact],
# gatedBy: [Policy], actor: Role }. produces/requires reference Artifacts;
# gatedBy references Policies; actor names a Role.

aegis:StepShape a sh:NodeShape ;
    sh:targetClass aegis:Step ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:produces ;
        sh:class aegis:Artifact ;
    ] ;
    sh:property [
        sh:path aegis:requires ;
        sh:class aegis:Artifact ;
    ] ;
    sh:property [
        sh:path aegis:gatedBy ;
        sh:class aegis:Policy ;
    ] ;
    sh:property [
        sh:path aegis:actor ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ── Transition ─────────────────────────────────────────────────────
# A guarded edge from a Step: { on: <outcome>, to: <Step> }. Branches and
# loops are just multiple Transitions; the guard predicate is evaluated by
# the same machinery. `on` is the triggering outcome, `to` the target Step.

aegis:TransitionShape a sh:NodeShape ;
    sh:targetClass aegis:Transition ;
    sh:property [
        sh:path aegis:on ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:to ;
        sh:class aegis:Step ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ── Artifact ───────────────────────────────────────────────────────
# An entity standing for a thing produced or required (design doc, test
# result, ADR, commit, review). Carries a Reference to a concrete target
# and a Claim it must satisfy. Verified at the leaf.

aegis:ArtifactShape a sh:NodeShape ;
    sh:targetClass aegis:Artifact ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:reference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:claim ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ── PlanStep ───────────────────────────────────────────────────────
# The intent map's atom: references a CodeSymbol (the edit target) and
# belongs to the running Step. Only Hank binds intent→structure live.

aegis:PlanStepShape a sh:NodeShape ;
    sh:targetClass aegis:PlanStep ;
    sh:property [
        sh:path aegis:references ;
        sh:class aegis:CodeSymbol ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:inStep ;
        sh:class aegis:Step ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Policy — the verifier. targets an entity TYPE (as a SHACL shape targets
# a class); carries the composed claim. External: one policy governs all
# entities of its target type. (Also an aegis:Directive by subclass, so the
# Directive shape's authority/issuedBy/label apply.)
# ═══════════════════════════════════════════════════════════════════

aegis:PolicyShape a sh:NodeShape ;
    sh:targetClass aegis:Policy ;
    sh:property [
        sh:path aegis:targets ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:claim ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Where the gate binds: an action boundary (pre-edit) or a step
        # transition. The effect may be computed from risk x confidence.
        sh:path aegis:boundary ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "action" "transition" ) ;
    ] ;
    sh:property [
        # The RESPONSE when the claim is unsatisfied — distinct from
        # `constraintClass`, which says what kind of bound this is. `throttle`
        # is the soft-class response SARC §4.2 places at the PAA: it cannot
        # prevent the action that just completed, but it backs off the ones
        # after it (see `aegis:backoffFormula`).
        sh:path aegis:effect ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "allow" "warn" "require-approval" "deny" "escalate" "record" "throttle" ) ;
    ] ;
    sh:property [
        # The workflow to instantiate when the effect requires one
        # (require-approval / escalate) — points at an aegis:Workflow. This is the
        # seam a consumer (a Hank edit-guard, or a Shantytown event subscriber)
        # reads to learn WHICH workflow a governed change assigns.
        sh:path aegis:assignsWorkflow ;
        sh:class aegis:Workflow ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # A structural (tree-sitter-tier) policy names the two atoms it composes:
        # the Selector that picks nodes and the Predicate that tests them. Both
        # OPTIONAL — a committed-tier policy carries only its SPARQL-ASK `claim`.
        # Hank projects these atoms to evaluate the policy where the evidence is
        # hot, at the pre-edit seam (hank docs/book/src/design/policy-edit-hooks.md).
        sh:path aegis:selector ;
        sh:class aegis:Selector ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:predicate ;
        sh:class aegis:Predicate ;
        sh:maxCount 1 ;
    ] ;

    # ── SARC constraint metadata ────────────────────────────────────
    # SARC (arXiv:2605.07728) §3.1 models a constraint as
    # ⟨src, class, pred, verif, resp⟩ plus a declared operating point θ, and
    # §4.2 (Table 3) fixes which class may be enforced at which point. The
    # fields below supply the parts `boundary` + `effect` alone cannot:
    # `effect` was carrying BOTH the class and the response, which is why
    # "is this a hard constraint?" was not a question this graph could answer.
    #
    # Every field is sh:maxCount-only here, NOT minCount. Conditional
    # requirement ("an action-boundary policy must declare a class", "an
    # escalation must declare a reversibility window") is a cross-field rule
    # that SHACL core cannot state, and encoding it as an unconditional
    # minCount would reject every committed-tier policy that legitimately has
    # no structural placement. Those rules live in src/governance/placement.rs
    # and run at definition time alongside this shape — see
    # docs/design/policy-edit-hooks.md.

    sh:property [
        # SARC §3.1: C = Ch ∪ Cs ∪ Ce. The class is WHAT KIND of bound this is,
        # independent of what happens when it fires — hard constraints are never
        # admissible, soft ones are admissible at a declared cost, escalation
        # ones transfer control to a human.
        sh:path aegis:constraintClass ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "hard" "soft" "escalation" ) ;
    ] ;
    sh:property [
        # SARC §4.1: the enforcement point this constraint is evaluated at.
        # Finer than `boundary`, which stays as the coarse action/transition
        # split — an action-boundary constraint may be a Pre-Action Gate check,
        # an Action-Time Monitor, or a Post-Action Auditor, and the difference
        # decides whether it can prevent anything.
        sh:path aegis:verificationPoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "PAG" "ATM" "PAA" "tool_layer" "policy_layer" ) ;
    ] ;
    sh:property [
        # SARC §4.3: which architectural layer HOSTS the check. There is
        # deliberately no "prompt" value: a hard constraint hosted only at the
        # prompt layer is what SARC I6 exists to forbid, and a value the
        # vocabulary cannot express is one no deployment can accidentally
        # configure. Rejecting it here would be a check that could be turned
        # off; omitting it is a check that cannot fail to hold.
        sh:path aegis:hostedAtLayer ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "orchestration" "tool" "policy" ) ;
    ] ;
    sh:property [
        # SARC §3.1: src. Where the obligation comes from. `aegis:authority` on
        # the parent Directive says WHO issued it; this says what KIND of
        # instrument it is, which is what decides precedence when two
        # constraints conflict (§9.8: regulatory > contractual > operational).
        sh:path aegis:sourceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "regulatory" "contractual" "ethical" "operational" ) ;
    ] ;
    sh:property [
        # SARC §5.2/I2: a predicate without a declared operating point is
        # incomplete — the FP/FN trade-off is a decision the deploying
        # organization owns, not a default chosen by whoever wrote the regex.
        sh:path aegis:operatingPoint ;
        sh:class aegis:OperatingPoint ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # SARC §5.1: constraint evaluation must be O(tool latency), never
        # O(model latency). A declared budget is what makes that checkable
        # rather than aspirational; Hank already enforces a whole-guard deadline
        # (`policy.deadline_ms`) and this is its per-constraint refinement.
        sh:path aegis:latencyBudgetMs ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # SARC §5.3/I4: the window within which the contemplated action can
        # still be undone without compounding cost. An escalation whose queue
        # wait exceeds it is structurally too slow, whatever the operator does.
        sh:path aegis:reversibilityWindowSeconds ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # ONE permitted value, by design. SARC §5.3 requires a declared
        # default-DENY when no operator can service an escalation inside the
        # reversibility window: default-allow under load turns an escalation
        # constraint into a no-op exactly when it matters, which is the
        # opposite of oversight. Modelling it as a one-value enum rather than a
        # boolean means the unsafe setting is unrepresentable rather than
        # merely discouraged.
        sh:path aegis:onTimeout ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "deny" ) ;
    ] ;
    sh:property [
        # The backoff a `throttle` effect applies to SUBSEQUENT actions once a
        # soft window is crossed. Free-form (the consumer compiles it); present
        # so a throttling policy declares its response rather than leaving the
        # amount to the implementer.
        sh:path aegis:backoffFormula ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# OperatingPoint — the declared FP/FN posture of a predicate (SARC §5.2).
# Split out as its own node rather than flattened onto Policy so it can be
# shared by predicates that legitimately have the same calibration, and so
# the tolerances travel together with the basis they were measured against.
# ═══════════════════════════════════════════════════════════════════

aegis:OperatingPointShape a sh:NodeShape ;
    sh:targetClass aegis:OperatingPoint ;
    sh:property [
        # "exact_predicate" (no classifier error — an exact string/regex/typed
        # comparison), "threshold" (a numeric cut), or
        # "deterministic_threshold" (a threshold over an exact quantity).
        sh:path aegis:kind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "exact_predicate" "threshold" "deterministic_threshold" ) ;
    ] ;
    sh:property [
        # Blocked-a-valid-action rate this deployment accepts. For a hard
        # constraint SARC §5.2 expects this to be the tolerant one: a missed
        # violation is by definition unacceptable, a false block falls back to
        # escalation.
        sh:path aegis:falsePositiveTolerance ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:falseNegativeTolerance ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:threshold ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # What the threshold is measured over — the quantity, so a reader can
        # tell a spend cap from a symbol count without reading the claim.
        sh:path aegis:calibrationBasis ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Catalog leaves — the composable atoms policies are built from. A
# Selector yields a set (evidence → set); a Predicate tests an element.
# Both are evidence-grounded and tier-tagged.
# ═══════════════════════════════════════════════════════════════════

aegis:SelectorShape a sh:NodeShape ;
    sh:targetClass aegis:Selector ;
    sh:property [
        sh:path aegis:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:evidenceSource ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # For a tree-sitter-tier selector, the grammar the `.scm` evidenceSource is
        # written against (`rust`, `python`, …) — mirrors Hank's Rule.language.
        # Optional: a non-structural selector has no grammar.
        sh:path aegis:language ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:tier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "live" "lsp" "tree-sitter" "committed" "attested" ) ;
    ] .

aegis:PredicateShape a sh:NodeShape ;
    sh:targetClass aegis:Predicate ;
    sh:property [
        sh:path aegis:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:evidenceSource ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:tier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "live" "lsp" "tree-sitter" "committed" "attested" ) ;
    ] ;
    sh:property [
        # The predicate direction for a tree-sitter-tier rule — mirrors Hank's
        # rules::MatchType so a projected policy round-trips. Optional: a
        # SPARQL-ASK predicate encodes its own direction.
        sh:path aegis:matchType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "must-match" "must-not-match" "must-exist" ) ;
    ] ;
    sh:property [
        # An optional pre-filter regex: only captures whose text matches the gate
        # are tested by the predicate (e.g. only comments containing TODO).
        sh:path aegis:gate ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Verdict — a stored, signed, content-bound attestation (NOT a bare claim).
# An aegis:Observation by subclass. `outcome` distinguishes unknown (no
# evidence) from unsatisfied (evidence says no). Binding to the evidence
# content hash makes tamper/replay self-staling; predicateId lets any
# independent verifier re-derive it (checked, not trusted).
# ═══════════════════════════════════════════════════════════════════

aegis:VerdictShape a sh:NodeShape ;
    sh:targetClass aegis:Verdict ;
    sh:property [
        sh:path aegis:predicateId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:targetRef ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:outcome ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "satisfied" "unsatisfied" "unknown" ) ;
    ] ;
    sh:property [
        sh:path aegis:evidenceHash ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:verifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:signature ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:tier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "live" "lsp" "tree-sitter" "committed" "attested" ) ;
    ] ;
    sh:property [
        sh:path aegis:freshness ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "fresh" "stale" ) ;
    ] ;
    sh:property [
        sh:path aegis:confidence ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# VerifierRegistration — the root of trust (Phase 0). A governed, human-
# authored record of WHICH verifier identity may attest WHICH predicate. Quipu
# accepts a verdict only if its verifier is registered for that predicate — this
# concentrates trust into a small, human-owned surface. `publicKey` is optional
# until signing lands; the registration is meaningful as an authority record
# even before verdicts are cryptographically signed.
# ═══════════════════════════════════════════════════════════════════

aegis:VerifierRegistrationShape a sh:NodeShape ;
    sh:targetClass aegis:VerifierRegistration ;
    sh:property [
        sh:path aegis:verifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # The predicate-id(s) this identity is authorized to attest. Repeatable.
        sh:path aegis:attests ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:publicKey ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Decision — a human approve / reject / request-changes, a signed
# attested-evidence source (an aegis:DecisionRecord by subclass). Content-
# bound to what it approved, so an edit after signing goes stale.
# ═══════════════════════════════════════════════════════════════════

aegis:DecisionShape a sh:NodeShape ;
    sh:targetClass aegis:Decision ;
    sh:property [
        sh:path aegis:outcome ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "approve" "reject" "changes" ) ;
    ] ;
    sh:property [
        sh:path aegis:by ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:gate ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:evidenceHash ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Escalation Router (Q-SARC-ER) — bounded human oversight.
#
# SARC I4: "escalation without a bound is not human oversight; it is deferred
# autonomy." Before this, `require-approval` and `escalate` failed closed at the
# write gate with NO CHANNEL to grant approval — a refusal an operator could not
# act on, which is a worse control than an honest advisory.
#
# The router is ASYNCHRONOUS by design. A write gate is synchronous and cannot
# hold a transaction open while a human decides; nothing here blocks a process.
# What it does is make the refusal actionable: the attempt mints a
# DecisionRequest naming what was refused and who can rule on it, a human signs
# an aegis:Decision, and the next attempt succeeds. The "hold" is the agent
# retrying, not the engine waiting.
# ═══════════════════════════════════════════════════════════════════

# ── OperatorGroup ──────────────────────────────────────────────────
# WHO can rule, and what their capacity is. The capacity model is part of the
# SPECIFICATION rather than an unstated operational assumption: SARC §5.3 makes
# `W_q < τ_rev` a measurable property of an M/M/c queue, and a queue whose
# parameters are undeclared cannot be measured against a window.

aegis:OperatorGroupShape a sh:NodeShape ;
    sh:targetClass aegis:OperatorGroup ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Servers in the M/M/c sense — how many operators can rule in parallel.
        sh:path aegis:operatorCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Mean service time per decision, seconds. With operatorCount this is
        # enough to compute the expected wait and compare it to a constraint's
        # reversibility window.
        sh:path aegis:meanServiceSeconds ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # What happens outside declared hours. Only "deny" and
        # "defer_within_window" are expressible: an after-hours mode that
        # ALLOWED would be the default-allow-under-load SARC §5.3 names as the
        # opposite of oversight, and it is left unrepresentable for the same
        # reason `onTimeout` is.
        sh:path aegis:afterHours ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "deny" "defer_within_window" ) ;
    ] .

# ── DecisionRequest ────────────────────────────────────────────────
# One suspended action awaiting a ruling. Minted by the router when an
# escalation fires, and the thing that turns "denied" into "denied, and here is
# how to un-deny it".
#
# `expiresAt` is derived from the constraint's reversibility window, so a
# request that nobody services becomes a DENIAL at a declared time rather than
# sitting open forever. That is the whole of I4.

aegis:DecisionRequestShape a sh:NodeShape ;
    sh:targetClass aegis:DecisionRequest ;
    sh:property [
        # The policy that escalated.
        sh:path aegis:forPolicy ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # The entity whose write was suspended.
        sh:path aegis:forTarget ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path aegis:routedTo ;
        sh:class aegis:OperatorGroup ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Unix seconds after which an unserviced request is DENIED. Required:
        # a request with no expiry is the unbounded escalation I4 forbids.
        sh:path aegis:expiresAt ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Content binding, so an approval cannot survive a change to what it
        # approved. Same discipline as a Verdict's.
        sh:path aegis:evidenceHash ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Principal — WHO acts, and over which graphs (SARC I5, §9.3).
#
# Quipu's named graphs were already an isolation substrate: a registry with an
# enforced committed|overlay class, bind-once parent branches, and graph-scoped
# writes, retractions and idempotency in SQL. What was missing was never
# partitioning — it was AUTHORIZATION. Nothing said which principal may write to
# which graph, so the isolation was real and ungoverned.
#
# `authorityOver` is that grant. The effective authority of a call chain is the
# INTERSECTION of every link's, so a delegate can only narrow it; the wildcard
# "*" declines to narrow rather than widening, which is what lets a
# single-tenant deployment carry on unchanged. An empty intersection permits
# nothing and is a refusal, never a fallback to the principal's own authority —
# that fallback would be the authority escalation the rule exists to prevent.
# ═══════════════════════════════════════════════════════════════════

aegis:PrincipalShape a sh:NodeShape ;
    sh:targetClass aegis:Principal ;
    sh:property [
        # The stable id a call chain names. Distinct from the IRI so a chain can
        # be carried as short strings across a process boundary.
        sh:path aegis:principalId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Graph IRIs this principal may write, or "*" for every graph.
        # Repeatable. A principal with NO authorityOver holds nothing, not
        # everything: reading an absent grant as permission is how an
        # access-control layer becomes decorative.
        sh:path aegis:authorityOver ;
        sh:datatype xsd:string ;
    ] .

# ── ToolClass ──────────────────────────────────────────────────────
# One class of dispatchable action, and whether it traverses an enforcement
# point. This is SARC I7 made into DATA.
#
# I7 is a property of the *dispatch graph*, not of any one constraint: an agent
# harness exposes N classes of tool call, and enforcement completeness is the
# question of whether every class that can change state passes through a point
# where a constraint could stop it. Prose cannot answer that — a list in a design
# doc goes stale the first time a harness adds a tool, and nothing notices.
#
# `ungovernedReason` is the important field. An executable class with no
# `governedAt` and no reason is an unknown hole; the same class with a stated
# reason is an ACKNOWLEDGED bypass surface, which is a different thing an
# operator can weigh. Neither is "governed", and the checker never reports one as
# the other.

aegis:ToolClassShape a sh:NodeShape ;
    sh:targetClass aegis:ToolClass ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Who dispatches it — the harness, the daemon, a CI runner. Two classes
        # with the same name under different dispatchers are different classes,
        # because only one of them may traverse a hook.
        sh:path aegis:dispatchedBy ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Whether invoking it can change state. A read-only class needs no
        # enforcement point, and demanding one would bury the real gaps.
        sh:path aegis:executable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Enforcement points this class actually traverses. Repeatable — a tool
        # call can pass a pre-action gate and a post-action auditor both. Same
        # vocabulary as aegis:verificationPoint, deliberately: a constraint
        # placed at a point no class traverses can never fire, and that is only
        # checkable if the two enums are one enum.
        sh:path aegis:governedAt ;
        sh:datatype xsd:string ;
        sh:in ( "PAG" "ATM" "PAA" "tool_layer" "policy_layer" ) ;
    ] ;
    sh:property [
        # Why an executable class traverses nothing. Required in practice by the
        # inventory check rather than by minCount here, because the requirement
        # is conditional on `executable true` and `governedAt` being absent —
        # which SHACL can express only with sh:not/sh:or gymnastics that would
        # obscure what the rule is.
        sh:path aegis:ungovernedReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        # Where enforcement must happen instead, when it cannot happen here.
        # An acknowledged bypass surface with no stated alternative is a note
        # that something is unhandled; with one, it is a design.
        sh:path aegis:enforcedInsteadAt ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .
