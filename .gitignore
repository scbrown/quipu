# Test fixtures (generated). The -wal/-shm siblings carry the same data as the
# store itself, so they are ignored too — running the server against the fixture
# leaves them behind, and only the .db was covered (cf. the data/*.db note below).
test-fixtures/test-store.db
test-fixtures/*.db-wal
test-fixtures/*.db-shm

# Gas Town (added by gt)
.runtime/
.claude/
.logs/
__pycache__/
state.json
CLAUDE.md
CLAUDE.local.md

# host-local beads store redirect (path differs per machine; do not track)
.beads/redirect

# Runtime store — NEVER commit (aegis-mqnl).
# data/quipu.db was tracked in this PUBLIC repo carrying a live private graph:
# ~2.1MB holding several thousand internal service and host names. It arrived as
# collateral in an unrelated bugfix commit and no check ever saw it, because
# scanners skip binaries by suffix — the file was invisible to the very sweep
# written to find internal identifiers.
#
# (The first draft of this very comment listed the leaked hostnames as evidence,
# and the scrub caught it. A note explaining a leak is not exempt from it.)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log
.quipu/

# Local tool sidecar: index/hook telemetry, rewritten on every run.
# Tracking it made the tree permanently dirty, so every build reported
# git_dirty:true and the flag stopped meaning anything.
.bobbin/

# Copies of ui/ assets staged into the book by `just docs-assets`. Source of
# truth is ui/; committing them here would be a second copy that can drift.
docs/book/src/datalinks/datalinks.js
docs/book/src/datalinks/graph-canvas.js
docs/book/src/datalinks/vendor/
